{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "enum": [
        "valid",
        "missing",
        "stale",
        "conflict",
        "not_applicable",
        "provider_error",
        "unverified"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "fuyao",
            "ifind",
            "derived"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "endpoint",
        "field_path",
        "request_id",
        "query",
        "raw_ref"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "period_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "available_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "methodology_version": {
      "type": "string",
      "minLength": 1
    },
    "input_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "symbol",
    "metric_id",
    "value",
    "unit",
    "quality",
    "source",
    "retrieved_at",
    "data_as_of",
    "period_end",
    "available_at",
    "methodology_version",
    "input_evidence_ids",
    "notes"
  ]
}
