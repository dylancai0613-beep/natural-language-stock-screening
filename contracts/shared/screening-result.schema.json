{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "screening-result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "card_id": {
      "type": "string",
      "minLength": 1
    },
    "card_revision": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "included",
              "excluded",
              "unknown"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "condition_id": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "pass",
                    "fail",
                    "unknown"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reason_code": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "condition_id",
                "outcome",
                "evidence_ids",
                "reason_code"
              ]
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "symbol",
          "decision",
          "checks",
          "explanation"
        ]
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "comparison": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "previous_run_id": {
              "type": "string",
              "minLength": 1
            },
            "same_snapshot": {
              "type": "boolean"
            },
            "added": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "previous_run_id",
            "same_snapshot",
            "added",
            "removed"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "card_id",
    "card_revision",
    "snapshot_id",
    "executed_at",
    "status",
    "results",
    "errors",
    "comparison"
  ],
  "description": "执行输出格式，不是意图试卷；card_revision指已保存的试卷版本。"
}
