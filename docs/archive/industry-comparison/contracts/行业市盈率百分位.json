        "二级",
        "三级"
      ],
      "help": ""
    },
    "minimum_peer_count": {
      "label": "最少有效同行样本数",
      "kind": "integer",
      "required": true,
      "default": 5,
      "options": [],
      "help": "行业比较时至少2；样本不足属于数据问题，不要求客户编造数据"
    },
    "peer_universe": {
      "label": "行业样本范围",
      "kind": "choice",
      "required": true,
      "default": "all_industry_members",
      "options": [
