{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expression",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "condition_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logic": {
          "enum": [
            "all",
            "any"
          ]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "logic",
        "children"
      ]
    }
  ]
}
