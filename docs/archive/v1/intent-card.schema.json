{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intent-card",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "original_text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "needs_clarification",
        "ready"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "explicit_symbols",
            "index_constituents"
          ]
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "index_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "membership_as_of": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "symbols",
        "index_code",
        "membership_as_of"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "condition.schema.json"
      }
    },
    "expression": {
      "$ref": "expression.schema.json"
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "metric_id",
          "direction"
        ]
      }
    },
    "missing_policy": {
      "enum": [
        "separate_unknown",
        "exclude_with_reason"
      ]
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocking": {
            "type": "boolean"
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "question",
          "options",
          "blocking",
          "answer"
        ]
      }
    },
    "unsupported_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text",
          "reason"
        ]
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "original_text",
    "status",
    "as_of",
    "universe",
    "conditions",
    "expression",
    "preferences",
    "missing_policy",
    "clarifications",
    "unsupported_intents",
    "limit"
  ]
}
