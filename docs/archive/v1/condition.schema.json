{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "condition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "enum": [
        "gt",
        "gte",
        "lt",
        "lte",
        "eq",
        "between",
        "in"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "origin": {
      "enum": [
        "user_explicit",
        "system_default",
        "user_confirmed"
      ]
    },
    "original_text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "confirmed",
        "unsupported"
      ]
    }
  },
  "required": [
    "id",
    "metric_id",
    "operator",
    "value",
    "unit",
    "parameters",
    "origin",
    "original_text",
    "status"
  ]
}
